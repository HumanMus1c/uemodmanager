<UserControl x:Class="UEManager.UI.Views.DependencyBadges"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:UEManager.UI.ViewModels"
             mc:Ignorable="d">
    <!-- Prerequisite dependency capsules shown below a mod's name and in its details dialog. -->
    <ItemsControl ItemsSource="{Binding DependencyBadges}" Focusable="False">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <WrapPanel />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:ModDependencyBadge}">
                <Border x:Name="Capsule" Margin="0,0,6,3" Padding="8,2" CornerRadius="10" BorderThickness="1"
                        Background="{StaticResource Brush.PanelRaised}" BorderBrush="{StaticResource Brush.LineStrong}"
                        ToolTip="{Binding Hint}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="Glyph" Margin="0,0,5,0" VerticalAlignment="Center" Style="{StaticResource Text.Icon}"
                                   FontSize="10" Foreground="{StaticResource Brush.TextMuted}" Text="{Binding Glyph}" />
                        <TextBlock x:Name="Label" VerticalAlignment="Center" FontFamily="{DynamicResource Font.Label}"
                                   FontSize="11" Foreground="{StaticResource Brush.TextMuted}" Text="{Binding Label}" />
                    </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Tone}" Value="info">
                        <Setter TargetName="Capsule" Property="Background" Value="{StaticResource Brush.InfoPanel}" />
                        <Setter TargetName="Capsule" Property="BorderBrush" Value="{StaticResource Brush.Info}" />
                        <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Brush.Info}" />
                        <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Brush.Info}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="good">
                        <Setter TargetName="Capsule" Property="Background" Value="{StaticResource Brush.SuccessWash}" />
                        <Setter TargetName="Capsule" Property="BorderBrush" Value="{StaticResource Brush.Success}" />
                        <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Brush.Success}" />
                        <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Brush.Success}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="warn">
                        <Setter TargetName="Capsule" Property="Background" Value="{StaticResource Brush.WarningWash}" />
                        <Setter TargetName="Capsule" Property="BorderBrush" Value="{StaticResource Brush.Warning}" />
                        <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Brush.Warning}" />
                        <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Brush.Warning}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="bad">
                        <Setter TargetName="Capsule" Property="Background" Value="{StaticResource Brush.DangerWash}" />
                        <Setter TargetName="Capsule" Property="BorderBrush" Value="{StaticResource Brush.Danger}" />
                        <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Brush.Danger}" />
                        <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Brush.Danger}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
